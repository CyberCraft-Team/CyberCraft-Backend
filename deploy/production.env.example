# Copy to /srv/cybercraft/backend/.env, chmod 600, fill every required value.
PRODUCTION=1
DEBUG=False
USE_SSL=1
SECRET_KEY=
MOD_API_KEY=
ALLOWED_HOSTS=api.cybercraft.uz
BACKEND_URL=https://api.cybercraft.uz
SITE_URL=https://cybercraft.uz
CORS_ORIGINS=https://cybercraft.uz
CSRF_TRUSTED_ORIGINS=https://api.cybercraft.uz,https://cybercraft.uz
DB_NAME=cybercraft
DB_USER=cybercraft
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
# Supply SMTP details before enabling public registration/password recovery.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@cybercraft.uz
# Optional providers must match the website's public client configuration.
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
YGGDRASIL_ALLOW_PASSWORD_LOGIN=False

SERVERS_ROOT=/srv/cybercraft/backend/servers
