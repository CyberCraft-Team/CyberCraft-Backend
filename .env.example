# =============================================
# CyberCraft Backend — Environment Variables
# =============================================
# Bu faylni .env ga nusxa qiling va qiymatlarni to'ldiring.

# ---------------------
# CORE
# ---------------------
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------
# PRODUCTION (quyidagilarni production da qo'shing)
# ---------------------
# PRODUCTION=1
# USE_SSL=false
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---------------------
# DATABASE (default: SQLite)
# Production da PostgreSQL uchun:
# ---------------------
# USE_SQLITE=1
# DB_NAME=cybercraft
# DB_USER=cybercraft
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# ---------------------
# REDIS (ixtiyoriy — websocket va cache uchun)
# ---------------------
# REDIS_URL=redis://localhost:6379/0

# ---------------------
# CORS
# ---------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------
# EMAIL
# Development: console (hech kimga yuborilmaydi, terminal ga chiqadi)
# Production: SMTP
# ---------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@cybercraft.uz

# Production SMTP uchun:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ---------------------
# SITE
# ---------------------
SITE_URL=http://localhost:3000

# ---------------------
# OAUTH & BOT
# ---------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ---------------------
# SUPERUSER (build.sh uchun)
# ---------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-this-password

# ---------------------
# MINECRAFT SERVERS
# ---------------------
# SERVERS_ROOT=/path/to/servers
