# =============================================
# CyberCraft Backend — Environment Variables
# =============================================
# Bu faylni .env ga nusxa qiling va qiymatlarni to'ldiring.
#
# Sozlamalar config/settings/ paketida:
#   base.py  — umumiy
#   dev.py   — PRODUCTION o'rnatilmaganda
#   prod.py  — PRODUCTION o'rnatilganda
# Tanlov faqat PRODUCTION o'zgaruvchisiga bog'liq.

# ---------------------
# CORE
# ---------------------
# DEBUG faqat development da ta'sir qiladi; production da har doim False.
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Bu backend'ning tashqaridan ko'rinadigan manzili. Har bir Minecraft
# serverning authlib-injector javaagent argumentiga yoziladi — noto'g'ri
# qiymat o'yin ichidagi loginni jimgina buzadi.
BACKEND_URL=http://127.0.0.1:8000

# ---------------------
# PRODUCTION
# ---------------------
# PRODUCTION=1 o'rnatilsa prod.py ishlaydi va quyidagilar MAJBURIY bo'ladi:
#   SECRET_KEY, ALLOWED_HOSTS, REDIS_URL va DB konfiguratsiyasi.
# Ularsiz ilova ishga tushmaydi (ImproperlyConfigured) — avvalgidek
# jimgina SQLite ga tushib ketmaydi.
# PRODUCTION=1
# USE_SSL=0
# CSRF_TRUSTED_ORIGINS=https://cybercraft.uz,https://www.cybercraft.uz

# ---------------------
# DATABASE
# Development: SQLite (avtomatik).
# Production: quyidagilardan biri majburiy.
# ---------------------
# DATABASE_URL=postgres://cybercraft:password@localhost:5432/cybercraft
# yoki alohida:
# DB_NAME=cybercraft
# DB_USER=cybercraft
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432
# yoki production da ham SQLite (tavsiya etilmaydi):
# USE_SQLITE=1

# ---------------------
# REDIS
# Development: ixtiyoriy (o'rnatilmasa LocMem + InMemory ishlatiladi).
# Production: MAJBURIY — channel layer prosesslar orasida umumiy bo'lishi kerak.
# ---------------------
# REDIS_URL=redis://localhost:6379/0

# ---------------------
# CORS
# ---------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------
# THROTTLING (ixtiyoriy)
# Production default: anon 30/minute, user 120/minute
# ---------------------
# THROTTLE_RATE_ANON=150/minute
# THROTTLE_RATE_USER=500/minute
# THROTTLE_RATE_SENSITIVE=5/minute

# ---------------------
# EMAIL
# Development: console (terminal ga chiqadi).
# Production: EMAIL_HOST va EMAIL_HOST_USER berilsa SMTP ga o'tadi.
# ---------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@cybercraft.uz
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ---------------------
# SITE
# ---------------------
SITE_URL=http://localhost:3000

# ---------------------
# OAUTH & BOT
# ---------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ---------------------
# MOD API KEY
# O'yin ichidagi modlar (cybercraftauth, cybercraftranks) shu sirni
# X-CyberCraft-Key sarlavhasida yuboradi. U himoyalaydigan endpointlar:
#   POST /api/v1/minecraft/verify/       — kim serverga kira olishini hal qiladi
#   GET  /api/v1/rewards/player-rank(s)/ — o'yinchi ma'lumotlari
#
# Production da MAJBURIY — bo'lmasa ilova ishga tushmaydi.
# Development da bo'sh qoldirilsa endpointlar ochiq qoladi va ogohlantirish yoziladi.
#
# Generatsiya: python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Minecraft serverni ishga tushirishda ayni qiymatni bering:
#   java -Dcybercraft.api=https://api.cybercraft.uz -Dcybercraft.key=<qiymat> ...
# ---------------------
# MOD_API_KEY=

# ---------------------
# MINECRAFT SERVERS
# ---------------------
# SERVERS_ROOT=/srv/cybercraft/servers
# SERVER_ZIP_MAX_UPLOAD_BYTES=2147483648

# ---------------------
# SUPERUSER (faqat build.sh uchun)
# Qo'lda deploy qilganda `manage.py createsuperuser` ishlatilgani ma'qul —
# qarang deploy/README.md.
# ---------------------
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=change-this-password
